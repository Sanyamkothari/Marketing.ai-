# One copy of this file per client VM:  cp .env.example .env && chmod 600 .env
# .env holds secrets. It is gitignored. Never commit it, never paste it into a ticket or a chat.
# Put comments on their own line (as here): docker compose does not strip a comment after a value.

# ---------------------------------------------------------------------------
# 1. Where the product lives (read by docker compose and by Caddy)
# ---------------------------------------------------------------------------
# The client's address, no scheme. Its DNS A record must already point at this VM, and ports 80 and
# 443 must be open, or Caddy cannot get the HTTPS certificate.
DOMAIN=pilot-acme.example.com
# An address Let's Encrypt can write to if a certificate is about to expire and renewal is failing.
ACME_EMAIL=ops@example.com
# The image tag docker compose builds and runs. Change it on every upgrade (git short sha or a date);
# the old image stays on the VM, which is what makes a rollback one command.
IMAGE_TAG=pilot-1

# ---------------------------------------------------------------------------
# 2. Deployment mode (do not change these four for a pilot)
# ---------------------------------------------------------------------------
# prod: refuses to start without the secrets below, refuses CORS '*', fails closed without sign-in.
MARKETING_AI_ENV=prod
# local = the built-in users (PBKDF2 passwords, 8-hour sessions, lock-out after repeated failures).
MARKETING_AI_AUTH_MODE=local
# Exactly one proxy (Caddy) sits in front of the API; the sign-in rate limit reads the client address
# from the entry Caddy appended to X-Forwarded-For. 0 would count every client as Caddy's address.
MARKETING_AI_TRUSTED_PROXY_HOPS=1
# The new left-hand-menu look. The code default is "classic".
MARKETING_AI_UI_LAYOUT=campaigns

# ---------------------------------------------------------------------------
# 3. This client
# ---------------------------------------------------------------------------
# The one client this deployment serves. By convention c_<name in lower case, each run of other
# characters replaced by one _>_1, so "Acme Telecom" is c_acme_telecom_1. Whatever you set becomes the
# client's id: the first client created in the product is registered under it, and any other client id
# is refused with 403 on every route. Never change it after the first sign-in: consent and erasure
# records are keyed by it, and an id that does not match silently disables consent gating on runs.
MARKETING_AI_CLIENT_ID=c_acme_telecom_1
# The origin the browser loads the UI from: https:// plus DOMAIN, exactly. Comma separated if there
# are several. '*' is refused on prod. A request from any other origin gets no CORS permission.
MARKETING_AI_CORS_ORIGINS=https://pilot-acme.example.com

# ---------------------------------------------------------------------------
# 4. Secrets (generate once, store BOTH in the team's password manager, off this VM)
# ---------------------------------------------------------------------------
# Salt of every consent / erasure / audit hash. Generate (16+ characters):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Losing it orphans every consent, erasure and audit record. The API refuses a changed value.
MARKETING_AI_PRIVACY_SALT=
# Fernet key that encrypts the AI provider key (and any saved connection password) on disk. Generate:
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# (a Fernet key is 32 random bytes in urlsafe base64; stock python3 is enough)
# Losing it is survivable but annoying: the AI key has to be typed in again.
MARKETING_AI_CONNECTIONS_KEY=

# ---------------------------------------------------------------------------
# 5. Logs
# ---------------------------------------------------------------------------
# JSON lines on stdout: docker logs api. docker compose rotates them (50 MB x 5).
MARKETING_AI_LOG_FORMAT=json
# DEBUG, INFO, WARNING or ERROR.
MARKETING_AI_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# 6. Features
# ---------------------------------------------------------------------------
# The single Data Doctor. The code default is false; the repo's own docker-compose.yml turns it on.
MARKETING_AI_DATA_DOCTOR_UNIFIED=true

# ---------------------------------------------------------------------------
# 7. Backups (read only by backup.sh, restore.sh)
# ---------------------------------------------------------------------------
# Where backup.sh copies every tarball so a lost VM does not take the backups with it. One of:
#   rclone:<remote>:<path>      e.g. rclone:backup-s3:acme-pilot-backups   (rclone must be configured)
#   scp:<user>@<host>:<dir>     e.g. scp:backup@backup.example.com:/srv/acme   (key-based ssh, no prompt)
# Use an rclone "crypt" remote or an encrypted bucket: the tarball holds the client's data.
BACKUP_TARGET=
# How many days of tarballs to keep, locally and at the target.
BACKUP_KEEP_DAYS=14
