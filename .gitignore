# local artefact store (plan §3)
data/

# virtualenv
.venv/

# SQLite metadata store
*.db

# python bytecode
__pycache__/
*.pyc

# tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# build output
dist/
build/
*.egg-info/

# Claude Code agent worktrees (transient, never committed)
.claude/worktrees/

# generated synthetic test data (make_data.py defaults to a temp dir; this covers --out-dir .)
*_synthetic_*.csv

# node dependencies (prototype tests and screenshot tooling)
node_modules/

# Phase 4a
.venv-infra/
infra/cdk.out/
infra/.cdk.staging/
.image-digest
# M50: one deployment's own CDK context (alert email, budget, certificate ARN). It is read by every
# `cdk` command, `make aws-deploy` included, and it names an account's resources, so it is never
# committed (PARALLEL_WORK_PROTOCOL.md §5 rule 5); docs/AWS_DEPLOYMENT.md §4.2 shows its shape.
infra/cdk.context.json
